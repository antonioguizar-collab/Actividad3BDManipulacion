        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# 1. Cargar el dataset\n",
        "cars_df = pd.read_csv('automobile_dataset.csv')\n",
        "\n",
        "# Resumen de tipos de datos\n",
        "print(cars_df.info())\n",
        "\n",
        "# Identificar y reemplazar el símbolo '?' por NaN\n",
        "cars_df.replace('?', np.nan, inplace=True)\n",
        "\n",
        "# Convertir columnas numéricas que fueron leídas como 'object' debido a los '?'\n",
        "numeric_cols = ['normalized_losses', 'bore', 'stroke', 'horsepower', 'peak_rpm', 'price']\n",
        "for col in numeric_cols:\n",
        "    if col in cars_df.columns:\n",
        "        cars_df[col] = pd.to_numeric(cars_df[col])"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Verificar registros duplicados\n",
        "duplicados = cars_df.duplicated().sum()\n",
        "print(f\"Registros duplicados: {duplicados}\")\n",
        "\n",
        "# Porcentaje de valores faltantes por columna\n",
        "missing_pct = cars_df.isnull().mean() * 100\n",
        "print(\"\\nPorcentaje de valores faltantes por columna:\\n\", missing_pct[missing_pct > 0])\n",
        "\n",
        "# Estadísticas descriptivas de variables numéricas (incluyendo asimetría y curtosis)\n",
        "num_df = cars_df.select_dtypes(include=[np.number])\n",
        "desc_num = num_df.describe().T\n",
        "desc_num['skewness'] = num_df.skew()\n",
        "desc_num['kurtosis'] = num_df.kurtosis()\n",
        "print(\"\\nEstadísticas numéricas:\\n\", desc_num)\n",
        "\n",
        "# Estadísticas de variables categóricas (tablas de frecuencia)\n",
        "cat_df = cars_df.select_dtypes(include=['object'])\n",
        "for col in cat_df.columns:\n",
        "    print(f\"\\n--- Frecuencias de {col} ---\")\n",
